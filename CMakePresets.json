{
	"version": 6,
	"configurePresets": [
		{
			"name": "default",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
			}
		},
		{
			"name": "ci", "inherits": "default",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_C_COMPILER_LAUNCHER": "ccache",
				"CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"THUNDEREGG_ENABLE_DEBUG": true,
				"THUNDEREGG_MPIEXEC_FLAGS": "--oversubscribe",
				"petsc": true,
				"petsc_required": true,
				"fftw": true,
				"fftw_required": true,
				"p4est": true,
				"p4est_required": true,
				"lapack": true,
				"lapack_required": true
			}
		},
		{
			"name": "ci-clang", "inherits": "ci",
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping"
			},
			"environment": {
				"CXX": "clang++",
				"CC": "clang"
			}
		}
	],
	"buildPresets": [
		{
			"name": "default",
			"configurePreset": "default"
		},
		{
			"name": "ci",
			"configurePreset": "ci"
		},
		{
			"name": "ci-clang",
			"configurePreset": "ci-clang"
		}
	],
	"testPresets": [
		{
			"name": "default",
			"configurePreset": "default",
			"output": {
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error",
				"scheduleRandom": true,
				"stopOnFailure": false,
				"timeout": 300
			}
		},
		{
			"name": "ci", "inherits": "default",
			"configurePreset": "ci"
		},
		{
			"name": "ci-clang", "inherits": "default",
			"configurePreset": "ci-clang",
			"environment": {
				"LLVM_PROFILE_FILE": "${sourceDir}/out/test/${presetName}/test.profraw.%p"
			}
		}
	],
	"workflowPresets": [
	{
		"name": "default",
		"steps": [
			{
			"type": "configure",
			"name": "default"
			},
			{
			"type": "build",
			"name": "default"
			},
			{
			"type": "test",
			"name": "default"
			}
		]
		},
	{
		"name": "ci",
		"steps": [
		  {
			"type": "configure",
			"name": "ci"
		  },
		  {
			"type": "build",
			"name": "ci"
		  },
		  {
			"type": "test",
			"name": "ci"
		  }
		]
	  },
	  {
		"name": "ci-clang",
		"steps": [
		  {
			"type": "configure",
			"name": "ci-clang"
		  },
		  {
			"type": "build",
			"name": "ci-clang"
		  },
		  {
			"type": "test",
			"name": "ci-clang"
		  }
		]
	  }
	]
}
